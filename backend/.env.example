# Copia este archivo como .env. El .env real NUNCA se sube al repo.
PORT=3000

# Secreto para firmar los JWT. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Base de datos (Fase 1, Prisma). SQLite en desarrollo.
DATABASE_URL="file:./dev.db"

# Clave de Gemini (Fase 4). Solo vive en el servidor.
GEMINI_API_KEY=
