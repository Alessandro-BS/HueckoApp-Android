# Copia este archivo como .env. El .env real NUNCA se sube al repo.
PORT=3000

# Secreto para firmar los JWT. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Archivo SQLite (se crea solo). El módulo node:sqlite viene con Node 22.13+.
DATABASE_PATH=./data/hueckoapp.db

# Zona horaria del servidor. Al confirmar un plan, scheduledAt (la próxima vez que ocurre la franja)
# y scheduledDate («YYYY-MM-DD», la fecha que muestra la app) se calculan en esta zona. Si falta, se usa
# la del PC; en producción hay que fijarla siempre (el servidor suele estar en UTC y los planes se moverían).
TZ=America/Lima

# IA (Fase 4). La clave de Gemini solo vive en el servidor: https://aistudio.google.com/apikey
# Si se deja vacía, Huecko IA responde con datos de demostración (la app muestra «Modo demostración»).
GEMINI_API_KEY=
# Modelo (ver https://ai.google.dev/gemini-api/docs/models). gemini-1.5-flash ya no existe.
# Por defecto gemini-3.5-flash y no gemini-3.8-flash: en el nivel gratuito 3.8-flash solo permite 20 peticiones
# al día y suele estar saturado (503), así que no sirve para una demo de clase.
GEMINI_MODEL=gemini-3.5-flash
# Modelo de respaldo: se prueba una vez si el principal está saturado (503), sin cuota (429), no existe (404)
# o agota su tiempo (2/3 del total).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Nivel de razonamiento: minimal, low, medium o high. Menos razonamiento = respuestas más rápidas;
# «low» equilibra calidad y latencia (algunos modelos no aceptan «minimal»).
GEMINI_THINKING_LEVEL=low
# Tiempo máximo total de cada petición a la IA (incluido el respaldo), en milisegundos; después responde 503 AI_UNAVAILABLE.
GEMINI_TIMEOUT_MS=30000
# Llamadas a la IA por usuario cada 15 minutos.
AI_RATE_LIMIT=20
