<?xml version="1.0" encoding="utf-8"?>
<!--
  Colores del tema NATIVO, el que Android pinta antes de que arranque Compose.

  Solo existen para que la ventana de arranque no destelle en blanco puro ni en
  el morado por defecto de la plantilla. La paleta real de la aplicacion vive
  en ui/theme/Color.kt; si cambia una, hay que cambiar la otra.
-->
<resources>
    <!-- Equivale a HuePrimary -->
    <color name="hueck_primary">#FF4A3B77</color>
    <!-- Equivale a HueSurface -->
    <color name="hueck_surface">#FFF8F7FA</color>
    <!-- Equivale a HueSurfaceContainer -->
    <color name="hueck_surface_container">#FFF1EFF5</color>
    <!-- Equivale a HueOnSurface -->
    <color name="hueck_on_surface">#FF1C1B22</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
